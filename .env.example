# Copy to .env and fill in values before running make up
# SUBNET_* vars are only used by profile-secure — safe to leave as defaults for flat/standard

DOMAIN=CORP
DOMAIN_FQDN=corp.internal
ADMIN_PASSWORD=

SHARE_FINANCE=finance
SHARE_ENGINEERING=engineering
SHARE_HR=hr

SMB_BRIDGE=smb_test_bridge
SUBNET_FINANCE=192.168.40.0/24
SUBNET_ENGINEERING=192.168.50.0/24

SAMBA_IMAGE=ghcr.io/servercontainers/samba
